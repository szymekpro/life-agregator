<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.szymek.board</groupId>
    <artifactId>lmb-main</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>lmb-main</name>
    <description>Personal Board — Core Service (multi-module)</description>

    <modules>
        <module>modules/database</module>
        <module>modules/api-documentation</module>
        <module>modules/auth</module>
        <module>modules/core</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <springdoc.version>3.1.0</springdoc.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.szymek.board</groupId>
                <artifactId>lmb-database</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.szymek.board</groupId>
                <artifactId>lmb-api-documentation</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.szymek.board</groupId>
                <artifactId>lmb-auth</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

</project>
